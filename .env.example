# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está en .gitignore: los secretos nunca se suben al repo.

# Dominio de la tienda Shopify (sin https://)
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com

# Token de acceso público de la Storefront API
# (Admin de Shopify → Apps → Desarrollar apps → Headless / Storefront API)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
